@page "/"

@inject NavigationManager navigationManager
@inject IPartidasApiService partidasService
@inject IJugadoresApiService jugadoresService

@rendermode InteractiveServer

<PageTitle>TicTacToe</PageTitle>

<div class="container mx-auto max-w-lg p-6 bg-white rounded-lg shadow-xl text-center">

    <div class="game-container">
        <!-- PANTALLA DE SELECCIÓN DE JUGADOR -->
        <div class="selection-screen">
            <h1>Elige tu jugador</h1>
            <div class="player-buttons">
                <label class="form-label"><strong>Jugador X</strong></label>
                <InputSelect class="form-select" @bind-Value="Jugador1Id">
                    <option value="0" selected disabled>Elija una opci&oacute;n</option>
                    @foreach (var jugador in ListaJugadores)
                    {
                        <option value=@jugador.JugadorId disabled="@(jugador.JugadorId == Jugador2Id)">@jugador.Nombres</option>
                    }
                </InputSelect>

                <label class="form-label"><strong>Jugador O</strong></label>
                <InputSelect class="form-select" @bind-Value="Jugador2Id">
                    <option value=null selected disabled>Elija una opci&oacute;n</option>
                    @foreach (var jugador in ListaJugadores)
                    {
                        <option value=@jugador.JugadorId disabled="@(jugador.JugadorId == Jugador1Id)">@jugador.Nombres</option>
                    }
                </InputSelect>
            </div>
            <button class="btn btn-success btn-lg mt-4"
                    disabled="@(Jugador1Id == 0)"
                    @onclick="StartGame">
                Iniciar Partida
            </button>
        </div>
    </div>
</div>


@code {
    public int Jugador1Id { get; set; }
    public int? Jugador2Id { get; set; }
    public List<JugadorResponse> ListaJugadores { get; set; } = new List<JugadorResponse>();

    protected override async Task OnInitializedAsync()
    {
        await CargarJugadores();
    }

    private async Task CargarJugadores()
    {
        var response = await jugadoresService.GetJugadoresAsync();

        if (response is Resource<List<JugadorResponse>>.Success success)
        {
            ListaJugadores = success.Data;
        }
        else if (response is Resource<List<JugadorResponse>>.Error error)
        {
            Console.WriteLine($"Error al cargar partidas: {error.Message}");
        }
    }

    public async Task StartGame()
    {
        var creado = await partidasService.PostPartida(Jugador1Id, Jugador2Id);
        if (creado is Resource<PartidaResponse>.Success)
        {
            navigationManager.NavigateTo($"/game/{Jugador1Id}/{Jugador2Id}");
        }
        else if(creado is Resource<PartidaResponse>.Error error)
        {
            Console.WriteLine($"Error al iniciar el juego: {error.Message}");
        }
    }
}
