@page "/jugadores/create"

@inject IJugadoresApiService jugadoresService
@inject NavigationManager navigationManager
@rendermode InteractiveServer

<PageTitle>Crear Jugador</PageTitle>

<div class="container">
	<div class="card shadow-lg">
		@*Header*@
		<div class="card-header text-center">
			<h5 class="card-title">Crear Jugador</h5>
		</div>

		@*Body*@
		<div class="card-body">
			<div class="mb-3">
				<label class="form-label"><strong>Nombres</strong></label>
				<InputText class="form-control" @bind-Value="nombres" />
			</div>

			<div class="mb-3">
				<label class="form-label"><strong>Email</strong></label>
				<InputText class="form-control" @bind-Value="email" />
			</div>

			@if(!string.IsNullOrEmpty(AlertMessage))
			{
				<div class="alert alert-@AlertType alert-dismissible fade show" role="alert">
					<div>@AlertMessage</div>
				</div>
			}
		</div>

		@*Footer*@
		<div class="card-footer text-center mt-2">
			<div class="btn-group">
				@if (!(AlertType == "success"))
				{
					<button type="button" @onclick="Guardar" class="btn btn-outline-success bi bi-check-circle"> Guardar</button>
				}
				<a href="/jugadores/index" class="btn btn-outline-secondary bi bi-arrow-bar-left"> Volver</a>
			</div>
		</div>
	</div>
</div>

@code {
	public string AlertMessage { get; set; }
	public string AlertType { get; set; }

	public string nombres { get; set; }
	public string email { get; set; }

	public async Task Guardar()
	{
		var creado = await jugadoresService.PostJugadores(nombres, email);
		if (creado is Resource<JugadorResponse>.Success)
		{
			AlertMessage = "Jugador creado exitosamente.";
			AlertType = "success";
		}
		else if (creado is Resource<JugadorResponse>.Error)
		{
			AlertMessage = "Error al crear el jugador.";
			AlertType = "danger";
		}
	}
}
